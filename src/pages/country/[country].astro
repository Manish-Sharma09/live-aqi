---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CityTable from '../../components/ranking/CityTable.astro';
import MedianTrend from '../../components/aqi/MedianTrend.astro';
import StandardSwitch from '../../components/aqi/StandardSwitch.astro';
import Section from '../../components/ui/Section.astro';
import ErrorState from '../../components/ui/ErrorState.astro';
import { categoryFor, defaultStandardFor, isStandardId } from '../../lib/aqi/standards';
import { CONTINENTS, citiesInCountry, getCountryBySlug, regionName, regionsInCountry } from '../../lib/geo/places';
import { formatHour, relativeTime, tzAbbreviation } from '../../lib/format';
import { describeError } from '../../lib/services/http';
import { getAreaSnapshot, readingValue, type Snapshot } from '../../lib/services/reports';

export const prerender = false;

const country = getCountryBySlug(Astro.params.country ?? '');
if (!country) return Astro.rewrite('/404');

const regionCode = Astro.url.searchParams.get('region');
const regions = regionsInCountry(country.cc);
const region = regionCode && regions.some((r) => r.code === regionCode) ? regionCode : null;
const regionLabel = region ? regionName(country.cc, region) : undefined;
const stdParam = Astro.url.searchParams.get('std');
const standard = isStandardId(stdParam) ? stdParam : defaultStandardFor(country.cc);
const stdName = standard === 'in' ? 'India NAQI' : 'US AQI';
const timezone = citiesInCountry(country.cc)[0]?.timezone ?? 'UTC';

let snap: Snapshot | null = null;
let error: string | null = null;
try {
  snap = await getAreaSnapshot(country.cc, region ?? undefined);
  Astro.cache.set({ maxAge: 900, swr: 3600, tags: ['country'] });
} catch (err) {
  console.error('[country]', err);
  error = describeError(err);
  // Data provider down: tell crawlers to come back rather than index the error state.
  Astro.response.status = 503;
  Astro.response.headers.set('Retry-After', '600');
}

const valued = (snap?.readings ?? []).filter((r) => readingValue(r, standard) !== null);
const byWorst = [...valued].sort((a, b) => readingValue(b, standard)! - readingValue(a, standard)!);
const values = byWorst.map((r) => readingValue(r, standard)!).sort((a, b) => a - b);
const median = values.length ? values[Math.floor((values.length - 1) / 2)]! : null;
const medianCat = median !== null ? categoryFor(standard, median) : null;
const unhealthy = valued.filter((r) => categoryFor(standard, readingValue(r, standard)!).level >= 3).length;
const area = regionLabel ? `${regionLabel}, ${country.name}` : country.name;
const trendValues = snap?.trend ? snap.trend[standard] : [];

const site = Astro.site!.href.replace(/\/$/, '');
const canonicalPath = `/country/${country.slug}${region ? `?region=${encodeURIComponent(region)}` : ''}`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Live AQI', item: `${site}/` },
    { '@type': 'ListItem', position: 2, name: country.name, item: `${site}/country/${country.slug}` },
    ...(regionLabel ? [{ '@type': 'ListItem', position: 3, name: regionLabel, item: `${site}${canonicalPath}` }] : []),
  ],
};
---

<BaseLayout
  title={`${area} AQI Today — Live Air Quality Index & City Rankings | Live AQI`}
  description={`${area} AQI today: ${median !== null ? `median ${stdName} ${median} (${medianCat!.label}) across ${valued.length} cities. ` : ''}Live air quality index by city, most polluted and cleanest cities, 7-day trend and pollution levels.`}
  canonicalPath={canonicalPath}
  jsonLd={jsonLd}
>
  <section class="stage">
    <div class="shell pt-8 pb-12 lg:pt-12 lg:pb-16">
      <nav aria-label="Breadcrumb">
        <ol class="flex flex-wrap items-center gap-2 text-sm text-on-stage-faint">
          <li><a href="/world" class="hover:text-ink hover:underline">World</a></li>
          <li aria-hidden="true">/</li>
          <li>{CONTINENTS[country.continent]}</li>
          <li aria-hidden="true">/</li>
          {
            regionLabel ? (
              <>
                <li><a href={`/country/${country.slug}`} class="hover:text-ink hover:underline">{country.name}</a></li>
                <li aria-hidden="true">/</li>
                <li aria-current="page" class="text-on-stage-muted">{regionLabel}</li>
              </>
            ) : (
              <li aria-current="page" class="text-on-stage-muted">{country.name}</li>
            )
          }
        </ol>
      </nav>

      <div class="mt-8 grid gap-10 lg:grid-cols-[minmax(0,1.3fr)_minmax(0,1fr)] lg:items-end">
        <div>
          <h1 class="type-hero [overflow-wrap:anywhere]">Air quality in {regionLabel ?? country.name}</h1>
          {regionLabel && <p class="mt-3 text-lg text-on-stage-muted">{country.name}</p>}
        </div>
        <div class="flex flex-wrap items-center gap-3 lg:justify-end">
          <StandardSwitch current={standard} />
          {
            regions.length > 1 && (
              <form method="get" action={`/country/${country.slug}`} class="flex items-center gap-2">
                {stdParam && <input type="hidden" name="std" value={standard} />}
                <label for="region-select" class="sr-only">Region</label>
                <select
                  id="region-select"
                  name="region"
                  class="h-10 max-w-[14rem] rounded-full border border-line bg-surface px-4 text-sm font-semibold text-ink"
                >
                  <option value="">All regions</option>
                  {regions.map((r) => (
                    <option value={r.code} selected={r.code === region}>
                      {r.name}
                    </option>
                  ))}
                </select>
                {/* Explicit submit: navigating on `change` would fire on every arrow key (WCAG 3.2.2). */}
                <button class="btn btn-ghost-dark h-10" type="submit">Go</button>
              </form>
            )
          }
        </div>
      </div>

      {
        snap && valued.length > 0 && medianCat && (
          <dl class="mt-10 grid grid-cols-2 gap-3 lg:grid-cols-4">
            <div class="card p-5">
              <dt class="text-sm text-on-stage-faint">Median {stdName}</dt>
              <dd class="mt-3 flex items-center gap-3">
                <span class="w-1.5 self-stretch rounded-full" style={`background:${medianCat.color}`} aria-hidden="true" />
                <span>
                  <span class="block text-[2.25rem] leading-none font-extrabold tracking-[-0.03em]">{median}</span>
                  <span class="mt-1 block text-sm text-on-stage-muted">{medianCat.label}</span>
                </span>
              </dd>
            </div>
            <div class="card p-5">
              <dt class="text-sm text-on-stage-faint">Cities monitored</dt>
              <dd class="mt-3 text-[2.25rem] leading-none font-extrabold tracking-[-0.03em]">{valued.length}</dd>
            </div>
            <div class="card p-5">
              <dt class="text-sm text-on-stage-faint">Unhealthy or worse</dt>
              <dd class="mt-3 text-[2.25rem] leading-none font-extrabold tracking-[-0.03em]">{unhealthy}</dd>
              <dd class="mt-1 text-caption text-on-stage-faint">{standard === 'in' ? 'Poor' : 'Unhealthy'} category or above</dd>
            </div>
            <div class="card p-5">
              <dt class="text-sm text-on-stage-faint">Most polluted</dt>
              <dd class="mt-3 text-lg font-semibold">
                <a href={`/city/${byWorst[0]!.city.slug}`} class="hover:underline">{byWorst[0]!.city.name}</a>
              </dd>
              <dd class="text-sm text-on-stage-muted">{stdName} {readingValue(byWorst[0]!, standard)}</dd>
            </div>
          </dl>
        )
      }
      {
        snap && (
          <p class="byline mt-5 text-sm text-on-stage-faint">
            <span>Median of the {snap.requested} most populous cities{regionLabel ? ` in ${regionLabel}` : ''}, not an official national index</span>
            <span>Valid {formatHour(snap.validTime, timezone)} {tzAbbreviation(snap.validTime, timezone)}</span>
            <span>Fetched {relativeTime(snap.fetchedAt)}</span>
          </p>
        )
      }
    </div>
  </section>

  <div class="shell pt-12 lg:pt-16">
    {
      error || !snap ? (
        <ErrorState
          class="mb-16"
          title={`Air-quality data for ${area} is temporarily unavailable`}
          message={`${error ?? 'No data.'} We never substitute estimated values — please try again shortly.`}
          retryHref={Astro.url.pathname + Astro.url.search}
        />
      ) : valued.length === 0 ? (
        <p class="mb-16 text-muted">No cities in {area} are reporting right now.</p>
      ) : (
        <>
          <Section id="extremes" title={`Most polluted and cleanest in ${regionLabel ?? country.name}`}>
            <div class="grid grid-cols-1 gap-12 lg:grid-cols-2">
              <div>
                <h3 class="font-bold">Most polluted</h3>
                <div class="mt-3"><CityTable rows={byWorst.slice(0, 5)} standard={standard} caption="Most polluted cities" showCountry={false} compact /></div>
              </div>
              <div>
                <h3 class="font-bold">Cleanest</h3>
                <div class="mt-3"><CityTable rows={[...byWorst].reverse().slice(0, 5)} standard={standard} caption="Cleanest cities" showCountry={false} compact /></div>
              </div>
            </div>
          </Section>

          {snap.trend && trendValues.some((v) => v !== null) && (
            <Section
              boxed
              id="trend"
              title="The past seven days"
              description={`Hourly median ${stdName} across the monitored cities.`}
            >
              <MedianTrend times={snap.trend.times} values={trendValues} standard={standard} timezone={timezone} label={`Hourly median ${stdName}, ${area}, last 7 days`} />
            </Section>
          )}

          <Section id="cities" title={`All monitored cities in ${regionLabel ?? country.name}`}>
            <CityTable rows={byWorst} standard={standard} caption={`Cities in ${area} by ${stdName}`} showCountry={false} />
          </Section>

          {regions.length > 1 && !region && (
            <Section boxed id="regions" title="Explore by region">
              <ul class="grid gap-x-8 gap-y-2 sm:grid-cols-2 lg:grid-cols-4">
                {regions.map((r) => (
                  <li>
                    <a href={`/country/${country.slug}?region=${encodeURIComponent(r.code)}`} class="flex items-baseline justify-between gap-3 border-b border-line py-2 hover:underline">
                      <span>{r.name}</span>
                      <span class="font-mono text-xs text-subtle">{r.cities}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </Section>
          )}
        </>
      )
    }
  </div>
</BaseLayout>
