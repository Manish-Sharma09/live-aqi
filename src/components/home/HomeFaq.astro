---
/**
 * Home page FAQ accordion. Content and the matching FAQPage JSON-LD both come from
 * src/lib/content/home-faq.ts; the page passes the JSON-LD to BaseLayout.
 * Closed answers stay in the HTML, so search engines read them.
 */
import Icon from '../ui/Icon.astro';
import { HOME_FAQ } from '../../lib/content/home-faq';
---

<section id="faq" class="shell scroll-mt-24 pb-20 lg:pb-28" aria-labelledby="faq-title" data-reveal>
  <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.6fr)] lg:gap-16">
    <div class="lg:sticky lg:top-24 lg:self-start">
      <h2 id="faq-title" class="type-section">AQI questions, answered</h2>
      <p class="mt-4 max-w-md text-ink-2">
        Quick answers about the air quality index, AQI levels, the data behind Live AQI and pollution alerts.
      </p>
      <a href="/what-is-aqi" class="btn btn-secondary mt-6">What is AQI? <Icon name="arrow-right" size={16} /></a>
    </div>

    <div class="card divide-y divide-line px-5 sm:px-7">
      {
        HOME_FAQ.map((item) => (
          <details class="group py-5">
            <summary class="flex cursor-pointer list-none items-start justify-between gap-6 rounded-xs [&::-webkit-details-marker]:hidden">
              <h3 class="text-[1.0625rem] leading-snug font-bold text-ink">{item.q}</h3>
              <span class="mt-0.5 grid size-7 flex-none place-items-center rounded-full bg-surface-2 text-ink-2 transition-transform duration-200 group-open:rotate-180">
                <Icon name="chevron-down" size={16} />
              </span>
            </summary>
            <div class="prose-reading mt-3 text-ink-2">
              <p set:html={item.a} />
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>
