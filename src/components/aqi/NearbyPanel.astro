---
import { categoryFor, type StandardId } from '../../lib/aqi/standards';
import { formatNumber } from '../../lib/format';
import type { CityReading } from '../../lib/services/reports';
import type { Station } from '../../lib/services/waqi';

interface Props {
  cities: Array<{ reading: CityReading; distanceKm: number }>;
  stations: Array<Station & { distanceKm: number }>;
  standard: StandardId;
  stationsEnabled: boolean;
}

const { cities, stations, standard, stationsEnabled } = Astro.props;
const badge = (std: StandardId, v: number) => {
  const c = categoryFor(std, v);
  return `--cat:${c.color};--cat-ink:${c.ink}`;
};
const stdName = standard === 'in' ? 'India NAQI' : 'US AQI';
---

<div class:list={['grid gap-10', stationsEnabled && stations.length > 0 && 'lg:grid-cols-2 lg:gap-14']}>
  {
    stationsEnabled && stations.length > 0 && (
      <div>
        <h3 class="font-bold">Ground monitoring stations</h3>
        <p class="mt-1 text-sm text-subtle">
          Measured at each station on the US EPA scale, via the World Air Quality Index Project. These aren’t directly
          comparable with the modelled reading above.
        </p>
        <ul class="mt-3 divide-y divide-line border-y border-line">
          {stations.map((s) => (
            <li class="flex items-center gap-4 py-3">
              <span class="aqi-badge" style={badge('us', s.aqi!)} title={`US AQI ${s.aqi} — ${categoryFor('us', s.aqi!).label}`}>
                {s.aqi}
              </span>
              <div class="min-w-0 flex-1">
                <a
                  href={`/map?lat=${s.lat.toFixed(4)}&lon=${s.lon.toFixed(4)}&z=12&layer=stations`}
                  class="block truncate font-semibold hover:underline"
                >
                  {s.name.split(';')[0]}
                </a>
                <p class="text-sm text-subtle">
                  {formatNumber(s.distanceKm, 1)} km away, {categoryFor('us', s.aqi!).label}
                  {s.time ? ` · ${s.time.replace('T', ' ').slice(0, 16)}` : ''}
                </p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    )
  }
  <div>
    <h3 class="font-bold">Major cities nearby</h3>
    {
      cities.length === 0 ? (
        <p class="mt-3 text-muted">No other major monitored cities within 400 km.</p>
      ) : (
        <ul class="mt-3 divide-y divide-line border-y border-line">
          {cities.map(({ reading, distanceKm }) => {
            const v = standard === 'us' ? reading.us : reading.in;
            return (
              <li class="flex items-center gap-4 py-3">
                {v !== null ? (
                  <span class="aqi-badge" style={badge(standard, v)} title={`${stdName} ${v} — ${categoryFor(standard, v).label}`}>
                    {v}
                  </span>
                ) : (
                  <span class="aqi-badge">—</span>
                )}
                <div class="min-w-0 flex-1">
                  <a href={`/city/${reading.city.slug}`} class="block truncate font-semibold hover:underline">
                    {reading.city.name}
                  </a>
                  <p class="text-caption text-subtle">
                    {reading.country}, {formatNumber(distanceKm, 0)} km away{v !== null ? `. ${categoryFor(standard, v).label}` : ''}
                  </p>
                </div>
              </li>
            );
          })}
        </ul>
      )
    }
  </div>
</div>
