---
import type { StandardId } from '../../lib/aqi/standards';

interface Props {
  current: StandardId;
  /** Base path; current query parameters are preserved. */
  path?: string;
  class?: string;
}
const { current, path = Astro.url.pathname, class: className } = Astro.props;

const hrefFor = (std: StandardId) => {
  const params = new URLSearchParams(Astro.url.search);
  params.set('std', std);
  return `${path}?${params}`;
};
---

<nav aria-label="AQI standard" class:list={['seg', className]}>
  {/* .vt-std-thumb: the selected pill glides to the new choice across the page change. */}
  <a href={hrefFor('us')} class="vt-std-thumb" aria-current={current === 'us' ? 'page' : undefined} title="US EPA Air Quality Index">US AQI</a>
  <a href={hrefFor('in')} class="vt-std-thumb" aria-current={current === 'in' ? 'page' : undefined} title="India National Air Quality Index (CPCB)">India NAQI</a>
</nav>
