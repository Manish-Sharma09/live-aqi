---
/** Segmented AQI scale with a marker at the current value. */
import { STANDARDS, type StandardId } from '../../lib/aqi/standards';

interface Props {
  standard: StandardId;
  value: number | null;
  class?: string;
}
const { standard, value, class: className } = Astro.props;
const def = STANDARDS[standard];
const max = def.scaleMax;
const cats = def.categories;
// Equal-width segments read better at small sizes; the marker is placed within its segment.
const pos = (() => {
  if (value === null) return null;
  const v = Math.min(Math.max(value, 0), max);
  const i = cats.findIndex((c) => Math.round(v) <= c.max);
  const c = cats[i === -1 ? cats.length - 1 : i]!;
  const lo = c.level === 0 ? 0 : c.min - 1;
  const hi = Math.min(c.max, max);
  const within = hi > lo ? (v - lo) / (hi - lo) : 1;
  return ((c.level + Math.min(Math.max(within, 0), 1)) / cats.length) * 100;
})();
const first = cats[0]!.label;
const last = cats[cats.length - 1]!.label;
---

<div class:list={['w-full', className]}>
  <div
    class="relative h-2.5"
    role="img"
    aria-label={value === null ? `${def.shortName} scale` : `${def.shortName} ${value} on a scale from ${first} to ${last}`}
  >
    <div class="flex h-full gap-1">
      {cats.map((c) => <span class="h-full flex-1 rounded-full" style={`background:${c.color}`} />)}
    </div>
    {
      pos !== null && (
        <span
          class="absolute top-1/2 size-[1.125rem] -translate-x-1/2 -translate-y-1/2 rounded-full border-[3px] border-ink bg-white shadow-[0_2px_6px_rgb(0_0_0/0.25)] dark:border-white dark:bg-[#0b1630]"
          style={`left:${pos.toFixed(2)}%`}
        />
      )
    }
  </div>
  <div class="mt-2 flex justify-between text-[0.75rem] text-ink-3">
    <span>{first}</span>
    <span>{last}</span>
  </div>
</div>
