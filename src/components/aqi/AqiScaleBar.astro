---
/** Segmented AQI scale with a marker at the current value. */
import { STANDARDS, type StandardId } from '../../lib/aqi/standards';

interface Props {
  standard: StandardId;
  value: number | null;
  class?: string;
}
const { standard, value, class: className } = Astro.props;
const def = STANDARDS[standard];
const max = def.scaleMax;
const cats = def.categories;
// Equal-width segments read better at small sizes; the marker is placed within its segment.
const GAP = '0.25rem'; // gap-1 between segments
const MARKER = '1.125rem'; // marker diameter (size-[1.125rem])
/**
 * Marker centre as a CSS length across the bar. It travels only between
 * (segment start + radius) and (segment end − radius), so the whole marker sits
 * on its own colour: a reading just inside a band (e.g. 156, Unhealthy) never
 * straddles the boundary and looks like the band below.
 */
const pos = (() => {
  if (value === null) return null;
  const v = Math.min(Math.max(value, 0), max);
  const i = cats.findIndex((c) => Math.round(v) <= c.max);
  const c = cats[i === -1 ? cats.length - 1 : i]!;
  const lo = c.level === 0 ? 0 : c.min - 1;
  const hi = Math.min(c.max, max);
  const within = Math.min(Math.max(hi > lo ? (v - lo) / (hi - lo) : 1, 0), 1);
  const n = cats.length;
  const seg = `((100% - ${n - 1} * ${GAP}) / ${n})`;
  return `calc(${c.level} * (${seg} + ${GAP}) + ${seg} / 2 + ${(within - 0.5).toFixed(4)} * max(0px, ${seg} - ${MARKER}))`;
})();
const first = cats[0]!.label;
const last = cats[cats.length - 1]!.label;
---

<div class:list={['w-full', className]}>
  <div
    class="relative h-2.5"
    role="img"
    aria-label={value === null ? `${def.shortName} scale` : `${def.shortName} ${value} on a scale from ${first} to ${last}`}
  >
    <div class="flex h-full gap-1">
      {cats.map((c) => <span class="h-full flex-1 rounded-full" style={`background:${c.color}`} />)}
    </div>
    {
      pos !== null && (
        // The track spans the bar so the marker can slide in from the start with a transform.
        <span class="scale-track pointer-events-none absolute inset-0" style={`--pos:${pos}`}>
          <span
            class="absolute top-1/2 left-(--pos) size-[1.125rem] -translate-x-1/2 -translate-y-1/2 rounded-full border-[3px] border-ink bg-white shadow-[0_2px_6px_rgb(0_0_0/0.25)] dark:border-white dark:bg-[#0b1630]"
          />
        </span>
      )
    }
  </div>
  <div class="mt-2 flex justify-between text-[0.75rem] text-ink-2">
    <span>{first}</span>
    <span>{last}</span>
  </div>
</div>
