---
/**
 * Live AQI mark: a cloud-and-sun outline on a tile that runs from sky cyan to
 * deep sea navy. Same drawing as the favicon and app icons
 * (scripts/build-brand-assets.mjs): keep the two in step.
 */
interface Props {
  size?: number;
  withWordmark?: boolean;
  class?: string;
}
const { size = 30, withWordmark = true, class: className } = Astro.props;
// One gradient id per copy: if a copy's <svg> is hidden, others pointing at its id would lose their fill.
const gradientId = `logo-tile-${Math.random().toString(36).slice(2, 8)}`;
---

<span class:list={['inline-flex items-center gap-2.5', className]}>
  <svg width={size} height={size} viewBox="0 0 510 510" aria-hidden="true" focusable="false" class="shrink-0">
    <defs>
      <linearGradient id={gradientId} x1="0" y1="1" x2="0" y2="0">
        <stop offset="0" stop-color="#002024" />
        <stop offset="0.08" stop-color="#073f5e" />
        <stop offset="1" stop-color="#00d4ff" />
      </linearGradient>
    </defs>
    <rect width="510" height="510" rx="120" fill={`url(#${gradientId})`} />
    <g
      transform="translate(42 42) scale(17.75)"
      fill="none"
      stroke="#fff3f3"
      stroke-width="1.3"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M12 2v2" />
      <path d="m4.93 4.93 1.41 1.41" />
      <path d="M20 12h2" />
      <path d="m19.07 4.93-1.41 1.41" />
      <path d="M15.947 12.65a4 4 0 0 0-5.925-4.128" />
      <path d="M13 22H7a5 5 0 1 1 4.9-6H13a3 3 0 0 1 0 6Z" />
    </g>
  </svg>
  {withWordmark && <span class="text-[1.1875rem] leading-none font-extrabold tracking-[-0.02em] whitespace-nowrap text-ink">Live AQI</span>}
</span>
