---
/** A dashboard section: heading + optional description; `boxed` wraps the content in a card. */
interface Props {
  id: string;
  title: string;
  description?: string;
  boxed?: boolean;
  class?: string;
}
const { id, title, description, boxed = false, class: className } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-title`} data-reveal class:list={['mb-14 scroll-mt-24 lg:mb-16', className]}>
  <div class="mb-4 flex flex-col gap-1 sm:mb-5 lg:flex-row lg:items-end lg:justify-between lg:gap-8">
    <h2 id={`${id}-title`} class="type-section">{title}</h2>
    {description && <p class="max-w-xl text-ink-2 lg:text-right">{description}</p>}
  </div>
  {
    boxed ? (
      <div class="card p-5 sm:p-7">
        <slot />
      </div>
    ) : (
      <slot />
    )
  }
</section>
