---
/**
 * Arrival splash: the Live AQI mark draws itself over the sky while the page
 * loads, then lifts away and the page makes its usual entrance underneath.
 *
 * Shown only on arrival (a new visit, a link from elsewhere, or a reload).
 * Moving around the site uses the page transition instead, and back/forward
 * restores a finished page. Without JavaScript it never appears.
 *
 * Must be the first thing in <body>: the inline script decides before the rest
 * of the page is parsed, so content never flashes up before the splash.
 * Same drawing as src/components/ui/Logo.astro.
 */
---

<div id="preloader" class="preloader" aria-hidden="true">
  <div class="preloader__brand">
    <svg class="preloader__mark" viewBox="0 0 510 510" width="88" height="88" focusable="false">
      <defs>
        <linearGradient id="pl-tile" x1="0" y1="1" x2="0" y2="0">
          <stop offset="0" stop-color="#002024"></stop>
          <stop offset="0.08" stop-color="#073f5e"></stop>
          <stop offset="1" stop-color="#00d4ff"></stop>
        </linearGradient>
      </defs>
      <rect width="510" height="510" rx="120" fill="url(#pl-tile)"></rect>
      <g
        transform="translate(42 42) scale(17.75)"
        fill="none"
        stroke="#fff3f3"
        stroke-width="1.3"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path class="pl-draw pl-cloud" pathLength="1" d="M13 22H7a5 5 0 1 1 4.9-6H13a3 3 0 0 1 0 6Z"></path>
        <path class="pl-draw pl-sun" pathLength="1" d="M15.947 12.65a4 4 0 0 0-5.925-4.128"></path>
        <path class="pl-draw pl-ray" style="--i: 0" pathLength="1" d="m4.93 4.93 1.41 1.41"></path>
        <path class="pl-draw pl-ray" style="--i: 1" pathLength="1" d="M12 2v2"></path>
        <path class="pl-draw pl-ray" style="--i: 2" pathLength="1" d="m19.07 4.93-1.41 1.41"></path>
        <!-- This ray's path already starts at the sun end, so it draws forwards. -->
        <path class="pl-draw pl-ray" style="--i: 3; --from: 1.05" pathLength="1" d="M20 12h2"></path>
      </g>
    </svg>
    <span class="preloader__word">Live AQI</span>
    <span class="preloader__bar"></span>
  </div>
</div>

<script is:inline>
  (function () {
    var MIN_MS = 950; // long enough for the mark to finish drawing (~880 ms, CSS below)
    var MAX_MS = 4000; // never hold the page longer than this, loaded or not
    var LEAVE_MS = 700; // the lift-away (CSS below), then the splash is removed
    var d = document.documentElement;
    var el = document.getElementById('preloader');
    if (!el) return;
    try {
      var nav = performance.getEntriesByType('navigation')[0];
      var type = nav ? nav.type : 'navigate';
      var from = '';
      try {
        from = document.referrer ? new URL(document.referrer).origin : '';
      } catch (e) {}
      if (!(type === 'reload' || (type === 'navigate' && from !== location.origin))) {
        el.remove();
        return;
      }
    } catch (e) {
      el.remove();
      return;
    }

    d.classList.add('preloading');
    var start = performance.now();
    var lifted = false;
    var lift = function () {
      if (lifted) return;
      lifted = true;
      // Classes first: the hero's entrance (paused while .preloading) plays as the splash fades.
      d.classList.add('preloader-leaving');
      d.classList.remove('preloading');
      setTimeout(function () {
        d.classList.remove('preloader-leaving');
        el.remove();
      }, LEAVE_MS);
      dispatchEvent(new Event('laqi:preloaded')); // motion.ts starts reveals and count-ups
    };
    addEventListener(
      'load',
      function () {
        setTimeout(lift, Math.max(0, MIN_MS - (performance.now() - start)));
      },
      { once: true },
    );
    setTimeout(lift, MAX_MS);
  })();
</script>

<style>
  .preloader {
    display: none;
  }
  :global(html.preloading) .preloader,
  :global(html.preloader-leaving) .preloader {
    position: fixed;
    inset: 0;
    z-index: var(--z-preloader);
    display: grid;
    place-items: center;
    background:
      radial-gradient(60vmax 40vmax at 50% 38%, color-mix(in srgb, var(--sky-bottom) 70%, transparent), transparent 70%),
      linear-gradient(180deg, var(--sky-top) 0%, var(--sky-mid) 55%, var(--bg) 100%);
    /* If the script that lifts it ever failed, it still gets out of the way. */
    animation: pl-failsafe 1ms linear 6s forwards;
  }

  .preloader__brand {
    display: grid;
    justify-items: center;
    gap: 0.875rem;
    margin-top: -4vh; /* optical centre */
  }
  .preloader__mark {
    border-radius: 21px; /* the tile's 120/510 */
    box-shadow:
      0 18px 32px -14px rgb(0 32 36 / 0.45),
      0 6px 12px -8px rgb(0 32 36 / 0.3);
  }
  /* At night the tile's navy base meets a navy sky: a faint rim keeps its edge. */
  :global([data-theme='dark']) .preloader__mark {
    box-shadow:
      0 0 0 1px rgb(150 200 255 / 0.14),
      0 18px 36px -14px rgb(0 0 0 / 0.6);
  }
  .preloader__word {
    color: var(--ink);
    font-size: 1.375rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  /* Indeterminate progress: a short light glides along a faint track. */
  .preloader__bar {
    position: relative;
    width: 6.5rem;
    height: 3px;
    margin-top: 0.375rem;
    overflow: hidden;
    border-radius: 999px;
    background: color-mix(in srgb, var(--ink) 12%, transparent);
  }
  .preloader__bar::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 40%;
    border-radius: inherit;
    background: var(--accent);
    transform: translateX(-100%);
  }

  .pl-draw {
    stroke-dasharray: 1 2; /* with pathLength=1: one dash the length of the path */
  }

  @media (prefers-reduced-motion: no-preference) {
    .preloader__mark {
      animation: pl-tile-in 560ms var(--ease-spring) both;
    }
    /* Whole mark is drawn by ~880 ms, inside MIN_MS in the script above. */
    .pl-cloud {
      animation: pl-draw 560ms var(--ease-out) 120ms both;
    }
    .pl-sun {
      animation: pl-draw 420ms var(--ease-out) 300ms both;
    }
    /* Rays draw outward from the sun, then keep a slow shimmer while loading continues. */
    .pl-ray {
      --from: -1.05;
      animation:
        pl-draw 280ms var(--ease-out) calc(420ms + var(--i) * 60ms) both,
        pl-shimmer 1.6s var(--ease-in-out) calc(1100ms + var(--i) * 140ms) infinite;
    }
    .preloader__word {
      animation: pl-rise 420ms var(--ease-out) 220ms both;
    }
    .preloader__bar {
      animation: pl-fade 300ms var(--ease-out) 700ms both;
    }
    .preloader__bar::before {
      animation: pl-glide 1.15s var(--ease-in-out) 700ms infinite;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .preloader__bar {
      display: none;
    }
  }

  /* Lift away: the mark opens up and fades, then the sky clears to the page. */
  :global(html.preloader-leaving) .preloader {
    opacity: 0;
    pointer-events: none;
    transition: opacity 480ms var(--ease-out) 90ms;
  }
  :global(html.preloader-leaving) .preloader__brand {
    opacity: 0;
    transform: scale(1.06);
    transition:
      opacity 260ms var(--ease-in),
      transform 420ms var(--ease-spring);
  }

  @keyframes pl-tile-in {
    from {
      opacity: 0;
      transform: translateY(8px) scale(0.82);
    }
  }
  @keyframes pl-draw {
    from {
      stroke-dashoffset: var(--from, 1.05);
    }
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes pl-shimmer {
    50% {
      opacity: 0.35;
    }
  }
  @keyframes pl-rise {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }
  @keyframes pl-fade {
    from {
      opacity: 0;
    }
  }
  @keyframes pl-glide {
    to {
      transform: translateX(250%);
    }
  }
  @keyframes pl-failsafe {
    to {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }
  }

  @media print {
    .preloader {
      display: none !important;
    }
  }
</style>
