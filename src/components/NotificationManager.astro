---
/**
 * In-page alerts: while any Live AQI page is open, re-checks the saved location
 * and shows an on-screen alert when the AQI category actually changes across
 * the visitor's threshold. These are clearly labelled "in-page" — background
 * notifications are handled separately by Web Push (see /alerts).
 */
---

<div
  id="toast-region"
  role="region"
  aria-label="Air quality alerts"
  class="pointer-events-none fixed inset-x-3 bottom-3 z-[60] flex flex-col items-end gap-2 sm:inset-x-auto sm:right-5 sm:bottom-5 sm:w-[24rem]"
>
</div>

<template id="toast-template">
  <div
    class="card pointer-events-auto w-full animate-toast p-4 shadow-pop"
    data-toast
  >
    <div class="flex items-start gap-3">
      <span data-swatch class="swatch mt-1.5 size-3"></span>
      <div class="min-w-0 flex-1">
        <p class="text-xs font-semibold text-ink-3" data-kind>In-page alert</p>
        <p class="mt-1 font-semibold" data-title></p>
        <p class="mt-1 text-sm text-ink-2" data-body></p>
        <a data-link class="mt-3 inline-flex items-center gap-1.5 text-sm font-semibold underline underline-offset-4">View dashboard</a>
      </div>
      <button type="button" data-dismiss class="grid size-8 shrink-0 place-items-center rounded-full hover:bg-surface-2" aria-label="Dismiss alert">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"></path></svg>
      </button>
    </div>
  </div>
</template>

<script>
  import { baselineState, composeAlert, evaluateAlert } from '../lib/aqi/alert-copy';
  import { alertLocation, fetchSummary, getAlertSettings, getLastSeen, setLastSeen, type Summary } from '../scripts/store';

  const CHECK_EVERY_MS = 15 * 60 * 1000;
  let lastCheck = 0;

  function showToast(opts: { title: string; body: string; href: string; color: string; urgent: boolean; kind: string }) {
    const region = document.getElementById('toast-region');
    const tpl = document.getElementById('toast-template') as HTMLTemplateElement | null;
    if (!region || !tpl) return;
    const node = tpl.content.firstElementChild!.cloneNode(true) as HTMLElement;
    node.setAttribute('role', opts.urgent ? 'alert' : 'status');
    node.querySelector<HTMLElement>('[data-swatch]')!.style.setProperty('--cat', opts.color);
    node.querySelector('[data-kind]')!.textContent = opts.urgent ? 'In-page alert · High priority' : `In-page alert · ${opts.kind}`;
    node.querySelector('[data-title]')!.textContent = opts.title;
    node.querySelector('[data-body]')!.textContent = opts.body;
    node.querySelector<HTMLAnchorElement>('[data-link]')!.href = opts.href;
    node.querySelector('[data-dismiss]')!.addEventListener('click', () => node.remove());
    region.insertBefore(node, region.firstChild);
    if (!opts.urgent) setTimeout(() => node.remove(), 20000);
  }

  function evaluate(token: string, s: Summary) {
    const settings = getAlertSettings();
    const standard = settings.standard === 'auto' ? s.defaultStandard : settings.standard;
    const r = s.readings[standard];
    if (!r) return;
    const prev = getLastSeen();
    // First reading for this location/standard: store a baseline, never alert on load.
    if (!prev || prev.token !== token || prev.standard !== standard) {
      setLastSeen({ token, standard, aqi: r.aqi, level: r.level, time: s.time, state: baselineState(r.level, settings.threshold, settings) });
      return;
    }
    // Only a newer data hour can trigger an alert.
    if (s.time <= prev.time) return;
    const { kind, next } = evaluateAlert(prev.state ?? null, r.level, s.time, settings.threshold, settings);
    setLastSeen({ token, standard, aqi: r.aqi, level: r.level, time: s.time, state: next });
    if (!kind || !settings.inPage) return;
    const msg = composeAlert(kind, s.name, standard, r.aqi, r.level);
    showToast({
      title: msg.title,
      body: msg.body,
      href: s.href,
      color: r.color,
      urgent: kind === 'severe',
      kind: kind === 'improved' ? 'Improvement' : 'Air quality change',
    });
  }

  async function check(force = false) {
    const loc = alertLocation();
    if (!loc) return;
    lastCheck = Date.now();
    const summary = await fetchSummary(loc.token, force);
    if (summary) evaluate(loc.token, summary);
  }

  const start = () => {
    check();
    setInterval(() => {
      if (document.visibilityState === 'visible') check(true);
    }, CHECK_EVERY_MS);
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible' && Date.now() - lastCheck > CHECK_EVERY_MS) check(true);
    });
  };
  if ('requestIdleCallback' in window) requestIdleCallback(start, { timeout: 4000 });
  else setTimeout(start, 1500);
</script>
