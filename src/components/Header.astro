---
import Logo from './ui/Logo.astro';
import Icon from './ui/Icon.astro';
import LocationSearch from './search/LocationSearch.astro';

interface Props {
  /** Place shown in the location selector (dashboard pages). */
  currentPlace?: { name: string } | undefined;
}
const { currentPlace } = Astro.props;
const path = Astro.url.pathname;
const nav = [
  { href: '/', label: 'Overview', match: (p: string) => p === '/' || p.startsWith('/city/') },
  { href: '/map', label: 'Map', match: (p: string) => p === '/map' },
  { href: '/rankings', label: 'Rankings', match: (p: string) => p === '/rankings' },
  { href: '/world', label: 'World', match: (p: string) => p === '/world' || p.startsWith('/country/') },
  { href: '/alerts', label: 'Alerts', match: (p: string) => p === '/alerts' },
];
---

<header class="site-header sticky top-0 z-(--z-header)">
  <div class="shell flex h-(--header-h) items-center gap-3">
    <a href="/" class="shrink-0 rounded-ui py-1" aria-label="Live AQI home">
      <Logo />
    </a>

    <nav aria-label="Primary" class="ml-4 hidden lg:block">
      <ul class="flex items-center gap-1">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={item.match(path) ? 'page' : undefined}
                class="vt-nav-thumb inline-flex h-10 items-center rounded-full px-4 text-[0.9375rem] font-semibold text-ink-2 transition-colors hover:bg-surface-2 hover:text-ink aria-[current=page]:bg-accent-soft aria-[current=page]:text-accent-ink aria-[current=page]:shadow-[inset_0_1px_0_0_var(--lg-rim),0_2px_8px_-4px_rgb(27_41_66/0.25)]"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="ml-auto flex min-w-0 items-center gap-2">
      <button
        type="button"
        data-open-search
        class="glass-pill inline-flex h-10 max-w-[8.75rem] min-w-0 items-center gap-1.5 rounded-full px-3 text-[0.9375rem] font-semibold text-ink sm:max-w-[16rem] sm:gap-2 sm:px-3.5"
        aria-haspopup="dialog"
        aria-keyshortcuts="/"
        title="Search a city (/)"
      >
        <Icon name="pin" size={17} class="shrink-0 text-ink-2" />
        <span data-location-label class="truncate">{currentPlace?.name ?? 'Search a city'}</span>
        <Icon name="chevron-down" size={16} class="shrink-0 text-ink-3" />
      </button>

      <span class="mx-1 hidden h-6 w-px bg-line sm:block" aria-hidden="true"></span>

      <button
        type="button"
        data-theme-toggle
        class="glass-pill grid size-10 shrink-0 place-items-center rounded-full text-ink"
        aria-label="Switch to night theme"
        title="Switch day / night"
      >
        <Icon name="sun" size={19} class="dark:hidden" />
        <Icon name="moon" size={18} class="hidden dark:block" />
      </button>

      <button
        type="button"
        data-menu-toggle
        class="glass-pill grid size-10 shrink-0 place-items-center rounded-full text-ink lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Menu"
      >
        <span class="menu-icons grid" aria-hidden="true">
          <span class="menu-icon" data-icon="open"><Icon name="menu" size={20} /></span>
          <span class="menu-icon" data-icon="close"><Icon name="x" size={20} /></span>
        </span>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" aria-label="Primary" hidden class="border-t border-line lg:hidden">
    <ul class="shell grid grid-cols-2 gap-2 py-3 sm:grid-cols-5">
      {
        nav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={item.match(path) ? 'page' : undefined}
              data-press
              style="--press: 0.97"
              class="flex h-11 items-center justify-center rounded-full border border-line bg-surface font-semibold text-ink-2 aria-[current=page]:border-transparent aria-[current=page]:bg-accent-soft aria-[current=page]:text-accent-ink"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<dialog
  id="search-dialog"
  aria-label="Search locations"
  class="glass glass-strong m-0 mx-auto mt-[9vh] w-[min(38rem,calc(100vw-1.5rem))] max-w-none overflow-visible rounded-card p-0 text-ink backdrop:bg-[rgb(8_18_43/0.38)] backdrop:backdrop-blur-[6px]"
>
  <div class="p-4 sm:p-5">
    <div class="mb-3 flex items-center justify-between">
      <p class="font-bold">Find air quality anywhere</p>
      <button type="button" data-close-search data-press class="grid size-9 place-items-center rounded-full hover:bg-surface-2">
        <Icon name="x" size={18} label="Close search" />
      </button>
    </div>
    <LocationSearch id="global-search" mode="navigate" label="Search a city, country, region or station" />
    <p class="mt-3 text-xs text-ink-3">Press <kbd class="font-semibold">/</kbd> anywhere to search. Use ↑ ↓ and Enter to choose.</p>
  </div>
</dialog>

<style>
  /* Menu ↔ close: the two marks cross-fade with a quarter turn. */
  .menu-icon {
    grid-area: 1 / 1;
    display: grid;
    place-items: center;
    transition:
      opacity 180ms var(--ease-out),
      transform 360ms var(--ease-spring);
  }
  .menu-icon[data-icon='close'],
  [aria-expanded='true'] .menu-icon[data-icon='open'] {
    opacity: 0;
    transform: rotate(-90deg) scale(0.6);
  }
  [aria-expanded='true'] .menu-icon[data-icon='open'] {
    transform: rotate(90deg) scale(0.6);
  }
  [aria-expanded='true'] .menu-icon[data-icon='close'] {
    opacity: 1;
    transform: none;
  }
</style>

<script>
  import { getSavedLocation, saveStandardPref, withStandard } from '../scripts/store';

  // Remember an explicit US/India choice (any page opened with ?std=) and carry it
  // across internal links, which otherwise fall back to each place's default.
  const stdParam = new URLSearchParams(window.location.search).get('std');
  if (stdParam === 'us' || stdParam === 'in') saveStandardPref(stdParam);
  const carryStandard = (e: MouseEvent) => {
    const a = (e.target as Element | null)?.closest?.('a[href]') as HTMLAnchorElement | null;
    if (!a || a.target === '_blank' || a.hasAttribute('download')) return;
    const href = a.getAttribute('href')!;
    const next = withStandard(href);
    if (next !== href) a.setAttribute('href', next);
  };
  document.addEventListener('click', carryStandard, true);
  document.addEventListener('auxclick', carryStandard, true);
  import type { LaqiSearch } from '../scripts/search-element';

  const dialog = document.getElementById('search-dialog') as HTMLDialogElement | null;
  const search = document.getElementById('global-search') as LaqiSearch | null;

  function openSearch() {
    if (!dialog || dialog.open) return;
    dialog.showModal();
    requestAnimationFrame(() => search?.focusInput());
  }
  document.querySelectorAll('[data-open-search]').forEach((b) => b.addEventListener('click', openSearch));
  document.querySelector('[data-close-search]')?.addEventListener('click', () => dialog?.close());
  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
  window.addEventListener('laqi:open-search', openSearch);
  document.addEventListener('keydown', (e) => {
    const t = e.target as HTMLElement;
    const typing = t.isContentEditable || ['INPUT', 'TEXTAREA', 'SELECT'].includes(t.tagName);
    if (e.key === '/' && !typing && !e.metaKey && !e.ctrlKey && !e.altKey) {
      e.preventDefault();
      openSearch();
    }
  });

  // Phone menu: the icon turns into a close mark (CSS below) and the menu
  // unfolds from under the header; a second tap mid-way reverses it smoothly.
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const mobileNav = document.getElementById('mobile-nav');
  let navAnim: Animation | undefined;
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.setAttribute('aria-expanded', String(open));
    if (!mobileNav) return;
    if (reducedMotion() || typeof mobileNav.animate !== 'function') {
      mobileNav.hidden = !open;
      return;
    }
    if (navAnim?.playState === 'running') {
      navAnim.reverse();
      return;
    }
    mobileNav.hidden = false;
    mobileNav.style.overflow = 'hidden';
    navAnim = mobileNav.animate(
      [
        { height: '0px', opacity: 0 },
        { height: `${mobileNav.scrollHeight}px`, opacity: 1 },
      ],
      { duration: 380, easing: 'cubic-bezier(0.32, 0.72, 0, 1)', direction: open ? 'normal' : 'reverse' },
    );
    navAnim.onfinish = () => {
      mobileNav.style.overflow = '';
      mobileNav.hidden = toggle.getAttribute('aria-expanded') !== 'true';
      navAnim = undefined;
    };
  });

  // Day / night. The sky follows the clock (laqiSky / laqiThemeOverride live in
  // BaseLayout's head script); the toggle overrides it for this page until the
  // next sunrise or sunset.
  type Theme = 'light' | 'dark';
  const sky = window as unknown as {
    laqiSky?: () => { theme: Theme | null; next: number | null };
    laqiThemeOverride?: () => Theme | null;
  };
  const root = document.documentElement;
  const themeBtn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const syncThemeLabel = () =>
    themeBtn?.setAttribute('aria-label', root.dataset.theme === 'dark' ? 'Switch to day theme' : 'Switch to night theme');
  syncThemeLabel();
  const reducedMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /** Switch theme; `from` = the toggle (new sky spreads from it), otherwise a slow fade like dusk. */
  const setTheme = (next: Theme, from?: HTMLElement) => {
    const apply = () => {
      root.dataset.theme = next;
      syncThemeLabel();
      // Keep the browser UI colour in step (same values as BaseLayout's head script).
      document.querySelector('meta[name="theme-color"]')?.setAttribute('content', next === 'dark' ? '#08122b' : '#e6ecf4');
      window.dispatchEvent(new CustomEvent('laqi:theme-change', { detail: next }));
    };
    if (!document.startViewTransition || reducedMotion() || document.visibilityState !== 'visible') return apply();
    root.classList.add('theme-vt'); // one snapshot of the whole page (see liquid.css)
    const transition = document.startViewTransition(apply);
    transition.ready
      .then(() => {
        if (!from) {
          root.animate({ opacity: [0, 1] }, { duration: 1400, easing: 'ease-in-out', pseudoElement: '::view-transition-new(root)' });
          return;
        }
        const r = from.getBoundingClientRect();
        const x = r.left + r.width / 2;
        const y = r.top + r.height / 2;
        const radius = Math.hypot(Math.max(x, window.innerWidth - x), Math.max(y, window.innerHeight - y));
        root.animate(
          { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${radius}px at ${x}px ${y}px)`] },
          { duration: 750, easing: 'cubic-bezier(0.32, 0.72, 0, 1)', pseudoElement: '::view-transition-new(root)' },
        );
      })
      .catch(() => {});
    transition.finished.finally(() => root.classList.remove('theme-vt'));
  };

  themeBtn?.addEventListener('click', () => {
    const next: Theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
    const now = sky.laqiSky?.() ?? { theme: null, next: null };
    try {
      const key = `laqi:theme:${location.pathname}`;
      // Back to what the sky says: no override needed. Otherwise hold it until the sky next changes.
      if (next === now.theme) sessionStorage.removeItem(key);
      else sessionStorage.setItem(key, `${next}|${now.next ?? Infinity}`);
    } catch {
      /* ignore */
    }
    setTheme(next, themeBtn);
  });

  // Turn dark at sunset (and light at sunrise) while the page is open. Checked each
  // minute and on returning to the tab: timers stall in background tabs and sleep.
  const followSky = () => {
    const want = sky.laqiThemeOverride?.() ?? sky.laqiSky?.().theme;
    if (want && want !== root.dataset.theme) setTheme(want);
  };
  setInterval(followSky, 60_000);
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible') followSky();
  });
  window.addEventListener('pageshow', (e) => {
    if (e.persisted) followSky(); // restored from the back/forward cache
  });

  // Outside dashboards, show the visitor's saved location in the selector.
  const label = document.querySelector<HTMLElement>('[data-location-label]');
  if (label && root.dataset.themeSource !== 'city') {
    const saved = getSavedLocation();
    if (saved) label.textContent = saved.name;
  }
</script>
