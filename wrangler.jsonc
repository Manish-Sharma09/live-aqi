{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "live-aqi",
	"compatibility_date": "2026-11-10",
	"compatibility_flags": ["global_fetch_strictly_public"],
	// Custom entry: Astro's request handler + a cron-driven push-alert sweep.
	"main": "./src/worker.ts",
	// Static assets are configured by the Astro adapter at build time (dist/client only).
	// Shared cache for world/country snapshots and Web Push subscriptions.
	// Wrangler provisions the namespace automatically on first deploy.
	"kv_namespaces": [
		{
			"binding": "LIVE_AQI_KV"
		}
	],
	// Per-IP limit on /api/* (see src/worker.ts): 120 requests per minute.
	// namespace_id is any account-unique integer you choose.
	"ratelimits": [
		{
			"name": "API_RATE_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 120, "period": 60 }
		}
	],
	"triggers": {
		// Every 30 minutes: pre-build the world snapshot when due, and check subscribers'
		// locations for AQI threshold crossings.
		"crons": ["*/30 * * * *"]
	},
	"vars": {
		"VAPID_SUBJECT": "mailto:alerts@live-aqi.com",
		// Google Analytics 4 measurement ID (Admin → Data streams → Web), e.g. "G-ABC123XYZ9".
		// Empty = analytics off. The privacy policy switches its analytics section on automatically.
		"GA_MEASUREMENT_ID": ""
	},
	"observability": {
		"enabled": true
	}
}
